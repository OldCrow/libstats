#pragma once
// Auto-generated by CMake from cmake/libstats_config.h.in — do not edit.
//
// Build-time configuration facts. Everything here is a property of the BUILD,
// so it must reach every translation unit that includes a libstats header —
// the library's own TUs, the test TUs, and installed consumers alike.
//
// Recorded as a header rather than as target_compile_definitions on purpose.
// The definition previously lived on libstats_simd_interface, which the
// library targets pull in as $<LINK_ONLY:...>; LINK_ONLY propagates the link
// and strips usage requirements, so the macro reached the library and the
// in-tree tests but never a find_package consumer. Consumers therefore
// compiled a different body for the same inline functions than the library
// shipped — an ODR violation, and a silent accuracy downgrade. Issue #97.
//
// A header also covers pkg-config and plain-include-path consumers, which no
// target property can reach.

// Defined when std::cyl_bessel_i (C++17 special math, §29.9.3) is available.
// GCC 6.1+, MSVC 2017 15.5+. NOT AppleClang/libc++ as of Xcode 16, where
// include/libstats/core/bessel.h falls back to A&S §9.8.1–9.8.4 polynomials
// accurate only to ~1.6e-7.
#cmakedefine LIBSTATS_HAS_CXX17_BESSEL
