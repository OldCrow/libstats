# Relocatable: prefix is derived from this file's own location, so
# `cmake --install <build> --prefix <other>` (and moving the tree) stay valid.
prefix=${pcfiledir}/@LIBSTATS_PC_PREFIX_REL@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libstats
Description: Modern C++20 statistical distributions library with SIMD and parallel performance
Version: @PROJECT_VERSION@
URL: https://github.com/OldCrow/libstats

Requires:
Libs: -L${libdir} -lstats
Libs.private: @LIBSTATS_PC_LIBS_PRIVATE@
Cflags: -I${includedir} -std=c++20
